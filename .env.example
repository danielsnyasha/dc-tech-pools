# Clerk API Keys — without these Clerk runs in "keyless mode" and sign-in fails with 422.
# Get them from https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk sends users after auth. The app also sets this on the
# <SignIn>/<SignUp> components, so these are optional.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/admin

# Database — this project uses MongoDB (see prisma/schema.prisma: provider = "mongodb").
# Prisma 7 reads this via prisma.config.ts. Without it every /admin request 500s.
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority"

# Uploadthing
UPLOADTHING_SECRET=...
UPLOADTHING_APP_ID=...
