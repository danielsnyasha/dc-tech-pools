// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Booking {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  customerName    String
  email           String
  phone           String
  serviceType     String
  poolSize        String?
  address         String
  city            String
  postalCode      String?
  preferredDate   DateTime
  preferredTime   String
  message         String?
  status          String        @default("pending") // pending, confirmed, completed, cancelled

  // Job management fields
  jobYear         Int?          // Year of the job (e.g., 2025)
  jobMonth        Int?          // Month (1-12)
  jobQuarter      String?       // Q1, Q2, Q3, Q4

  // Financial tracking in ZAR (Rands)
  revenue         Float?        // Total revenue/income received (what admin got)
  totalExpenses   Float?        // Total expenses (what admin spent)
  profit          Float?        // Calculated: revenue - totalExpenses

  // Expense breakdown by category
  laborCost       Float?        // Labor/workforce expenses
  materialsCost   Float?        // Materials and supplies
  equipmentCost   Float?        // Equipment rental or purchase
  transportCost   Float?        // Transport and logistics
  essentialsCost  Float?        // Other essentials (utilities, permits, etc.)

  // Legacy fields (kept for backward compatibility)
  allocatedBudget Float?        // Budget allocated for this job
  actualCost      Float?        // Actual cost incurred
  jobBreakdown    JobTask[]     // Array of tasks/breakdown items

  // Job completion images (stored in Cloudinary)
  completionImages String[]     @default([]) // Array of Cloudinary image URLs

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Job task breakdown for detailed job planning
type JobTask {
  taskName        String
  description     String?
  estimatedCost   Float
  actualCost      Float?
  category        String?       // labor, materials, equipment, transport, essentials
  assignedTo      String?       // Team member assigned
  status          String        // pending, in_progress, completed
  dueDate         DateTime?
  completedDate   DateTime?
}

model Testimonial {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerName  String
  rating        Int      @default(5)
  comment       String
  serviceType   String
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  category    String
  description String
  price       String?
  duration    String?
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Analytics {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  date             DateTime @default(now())
  bookingsCount    Int      @default(0)
  pageViews        Int      @default(0)
  contactFormCount Int      @default(0)
  avgSatisfaction  Float    @default(0)
}

model AdminEmail {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  addedBy     String?  // Email of admin who added this
  isDefault   Boolean  @default(false) // True for the 3 default admins
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AccessRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  clerkUserId String?
  status      String   @default("pending") // pending, approved, denied
  decidedBy   String?  // Email of admin who approved/denied
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
